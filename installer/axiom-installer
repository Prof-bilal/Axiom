#!/usr/bin/env python3
"""Axiom boot installer (Phase 6, ADR-020/021): a console UI over axiom_install.

Runs as root on the live medium. It only collects and validates input; every write is done by
axiom_install (argv-only, re-validated target). Esc goes back. Look and feel come from axiom_tui.
"""
import curses
import json
import os
import queue
import subprocess
import sys
import threading
import time

HERE = os.path.dirname(os.path.realpath(__file__))
for p in (HERE, "/usr/local/lib/axiom-tui", os.path.join(HERE, "..", "tui")):
    if os.path.isdir(p):
        sys.path.insert(0, p)
import axiom_install as ai  # noqa: E402
import axiom_tui as tui  # noqa: E402
from axiom_tui import BG, CYAN, GHOST, GREEN, ORANGE, RED, TEXT, WHITE  # noqa: E402

CATALOG = next((p for p in (os.path.join(HERE, "catalog", "developer-hub.json"),
                            "/usr/local/share/axiom/catalog/developer-hub.json",
                            os.path.join(HERE, "..", "catalog", "developer-hub.json")) if os.path.exists(p)), None)
ENTER = (10, 13, curses.KEY_ENTER)
HINT_FORM = "Up/Down  move      Left/Right  change      Enter  continue      Esc  go back"
# Curated pick-lists: arrow-key choices only, never free text. Every entry passes axiom_install's checks
# (LAYOUT_RE has no hyphen, so the Brazilian layout is "br", not "br-abnt2").
LOCALES = ["en_US", "en_GB", "de_DE", "fr_FR", "es_ES", "it_IT", "pt_BR", "nl_NL", "pl_PL", "ru_RU", "tr_TR",
           "ja_JP", "zh_CN"]
KEYMAPS = ["us", "uk", "de", "fr", "es", "it", "br"]
# Full names shown in the pick-lists; the stored values (locale and keymap codes) stay unchanged.
LOCALE_NAMES = {"en_US": "English (United States)", "en_GB": "English (United Kingdom)", "de_DE": "German",
                "fr_FR": "French", "es_ES": "Spanish", "it_IT": "Italian", "pt_BR": "Portuguese (Brazil)",
                "nl_NL": "Dutch", "pl_PL": "Polish", "ru_RU": "Russian", "tr_TR": "Turkish",
                "ja_JP": "Japanese", "zh_CN": "Chinese (Simplified)"}
KEYMAP_NAMES = {"us": "English (US)", "uk": "English (UK)", "de": "German", "fr": "French", "es": "Spanish",
                "it": "Italian", "br": "Portuguese (Brazil)"}


class Back(Exception):
    pass


# ---- widgets --------------------------------------------------------------------------------------
def page(ui, step, total, title):
    """Common page header; returns the first free row for the card."""
    ui.s.erase()
    y = ui.wordmark(0)
    if step:
        y += ui.steps(y, step, total)
    ui.put(y, (ui.w - min(ui.w - 6, 76)) // 2 + 2, title, fg=CYAN, bold=True)
    return y + 2


def form(ui, step, total, title, intro, fields, validate=None, footer=HINT_FORM):
    """fields: dicts with key,label,kind=text|password|toggle|choice,value,choices,hint,show,on_change."""
    idx, err = 0, ""
    while True:
        vis = [f for f in fields if f.get("show", lambda: True)()]
        idx = min(idx, len(vis))
        y = page(ui, step, total, title)
        cx, cw, _ = ui.card_geometry(0, y)
        inner = cw - 6
        for line in tui.wrap(intro, inner):
            ui.put(y, cx + 2, line, fg=TEXT)
            y += 1
        y += 1
        step_rows = 2 if ui.h - y - len(vis) * 2 >= 7 else 1  # a blank row between fields when there is room
        label_w, box_x = 24, cx + 2 + 24
        box_w = max(12, cw - 4 - label_w)
        for i, f in enumerate(vis):
            foc, kind = i == idx, f.get("kind", "text")
            row = y + i * step_rows
            ui.put(row, cx + 2, f["label"], fg=WHITE if foc else TEXT, bold=foc)
            fg, bg = (BG, CYAN) if foc else (TEXT, GHOST)
            if kind in ("text", "password"):
                shown = "*" * len(f["value"]) if kind == "password" else f["value"]
                shown = (shown[-(box_w - 2):] + ("_" if foc else "")).ljust(box_w)
            elif kind == "toggle":
                shown = ("[x] Yes" if f["value"] else "[ ] No").ljust(box_w)
            else:
                shown = ("<  " + str(f.get("names", {}).get(f["value"], f["value"])) + "  >").ljust(box_w)
            ui.put(row, box_x, " " + shown[:box_w - 1], fg=fg, bg=bg, bold=foc)
        y += len(vis) * step_rows
        ui.put(y, box_x, " Continue ", fg=BG if idx == len(vis) else CYAN, bg=CYAN if idx == len(vis) else BG,
               bold=True)
        y += 2
        if idx < len(vis) and vis[idx].get("hint"):
            for line in tui.wrap(vis[idx]["hint"], inner):
                ui.put(y, cx + 2, line, fg=TEXT)
                y += 1
        if err:
            for line in tui.wrap("! " + err, inner):
                ui.put(y + 1, cx + 2, line, fg=RED, bold=True)
                y += 1
        ui.footer(footer)
        ui.s.refresh()
        k = ui.s.getch()
        f = vis[idx] if idx < len(vis) else None
        if k == 27:
            raise Back()
        if k in (curses.KEY_UP, 16):
            idx = max(0, idx - 1)
        elif k in (curses.KEY_DOWN, 9):
            idx = min(idx + 1, len(vis))
        elif k in ENTER:
            if idx < len(vis) - 1:
                idx += 1
            else:
                try:
                    if validate:
                        validate()
                    return
                except ai.FormError as e:
                    err, idx = str(e), 0
        elif f is not None:
            kind = f.get("kind", "text")
            if kind in ("text", "password"):
                if k in (curses.KEY_BACKSPACE, 127, 8):
                    f["value"] = f["value"][:-1]
                elif tui.typed_char(k):
                    f["value"] += tui.typed_char(k)
            elif kind == "toggle" and k in (32, curses.KEY_LEFT, curses.KEY_RIGHT):
                f["value"] = not f["value"]
            elif kind == "choice" and k in (curses.KEY_LEFT, curses.KEY_RIGHT, 32):
                ch = f["choices"]
                i = ch.index(f["value"]) if f["value"] in ch else 0
                f["value"] = ch[(i + (-1 if k == curses.KEY_LEFT else 1)) % len(ch)]
                if f.get("on_change"):
                    f["on_change"]()
            err = ""


def tz_groups():
    """Every zone the live medium knows, grouped by region: {"Europe": ["Berlin", ...], "UTC": ["UTC"]}."""
    try:
        out = subprocess.run(["timedatectl", "list-timezones"], capture_output=True, text=True, env=ai.ENV).stdout
    except (OSError, subprocess.SubprocessError):
        out = ""
    groups = {}
    for zone in out.split():
        region, _, city = zone.partition("/")
        groups.setdefault(region, []).append(city or region)
    if not groups:
        groups = {"UTC": ["UTC"]}
    return {region: sorted(cities) for region, cities in groups.items()}


def tz_split(zone, groups):
    """(region, city) for a zone name; an unknown or stale AXIOM_TZ falls back to the first zone."""
    region, _, city = zone.partition("/")
    city = city or region
    if city not in groups.get(region, ()):  # list-timezones is authoritative, not the environment
        region = sorted(groups)[0]
        city = groups[region][0]
    return region, city


def tz_name(region, city):
    """The zone name handed to axiom_install: "UTC" stays flat, everything else is "Region/City"."""
    return region if city == region else f"{region}/{city}"


def tz_fields(groups, zone):
    """Region then City choices; changing the region rebuilds the city list through on_change."""
    region, city = tz_split(zone, groups)
    fs = [{"key": "region", "label": "Region", "kind": "choice", "choices": sorted(groups), "value": region,
           "hint": "Left/Right change. Pick the part of the world you are in."},
          {"key": "city", "label": "Time zone", "kind": "choice", "choices": groups[region], "value": city,
           "hint": "Left/Right change. Pick the city closest to you."}]

    def sync():
        fs[1]["choices"] = groups[fs[0]["value"]]
        if fs[1]["value"] not in fs[1]["choices"]:
            fs[1]["value"] = fs[1]["choices"][0]
    fs[0]["on_change"] = sync
    return fs


def menu(ui, title, items, intro="", penguin_fill=1.0):
    """items: (label, description). Returns the chosen index; Esc raises Back."""
    i = 0
    while True:
        ui.s.erase()
        text_rows = 2 + len(items) * 3 + 3
        art = tui.pick_penguin(ui.h - text_rows - 2)
        y = 0
        if art:
            y += ui.draw_penguin(0, art, penguin_fill) + 1
        else:
            y += ui.wordmark(0)
        ui.center(y, title, fg=CYAN, bold=True)
        y += 2
        for line in tui.wrap(intro, min(ui.w - 8, 70)):
            ui.center(y, line, fg=TEXT)
            y += 1
        y += 1
        w = min(ui.w - 8, 60)
        x = (ui.w - w) // 2
        for n, (label, desc) in enumerate(items):
            sel = n == i
            ui.put(y, x, ("  " + label).ljust(w), fg=BG if sel else WHITE, bg=CYAN if sel else BG, bold=True)
            ui.put(y + 1, x + 2, desc, fg=TEXT)
            y += 3
        ui.footer("Up/Down  move      Enter  choose")
        ui.s.refresh()
        k = ui.s.getch()
        if k == curses.KEY_UP and i > 0:
            i -= 1
        elif k == curses.KEY_DOWN and i < len(items) - 1:
            i += 1
        elif k in ENTER:
            return i
        elif k == 27:
            raise Back()


def load_catalog():
    try:
        return json.load(open(CATALOG))
    except (OSError, TypeError, ValueError):
        return {"items": [], "presets": {}, "categories": {}}


def hub(ui, step, total, form_data, catalog):
    items = catalog["items"]
    cats = catalog.get("categories", {})
    chosen = set(form_data.get("hub") or [i["id"] for i in items if i.get("default")])
    order = [i for c in cats for i in items if i["category"] == c] or items
    presets = ["custom"] + list(catalog.get("presets", {}))
    pos, pi, top = 0, 0, 0
    while True:
        y = page(ui, step, total, "Choose your tools")
        cx, cw, _ = ui.card_geometry(0, y)
        for line in tui.wrap("Pick the tools you want ready on your first start. They are set up for you after "
                             "the first restart. Nothing is installed until you confirm.", cw - 6):
            ui.put(y, cx + 2, line)
            y += 1
        ui.put(y, cx + 2, f"Starter set: {presets[pi]}    {len(chosen)} chosen", fg=CYAN)
        y += 2
        rows = max(3, ui.h - y - 3)
        top = min(max(top, pos - rows + 1), pos)
        shown = order[top:top + rows]
        for n, it in enumerate(shown, start=top):
            sel = n == pos
            box = "[x]" if it["id"] in chosen else "[ ]"
            label = f" {box}  {it['name']}"
            ui.put(y, cx + 2, label.ljust(cw - 4), fg=BG if sel else WHITE, bg=CYAN if sel else BG, bold=sel)
            ui.put(y, cx + cw - 2 - len(cats.get(it["category"], it["category"]).split(" (")[0]) - 1,
                   cats.get(it["category"], it["category"]).split(" (")[0], fg=BG if sel else GHOST, bg=CYAN if sel else BG)
            y += 1
        ui.footer("Up/Down  move      Space  choose      P  change starter set      Enter  continue      Esc  back")
        ui.s.refresh()
        k = ui.s.getch()
        if k == curses.KEY_UP and pos > 0:
            pos -= 1
        elif k == curses.KEY_DOWN and pos < len(order) - 1:
            pos += 1
        elif k == 32 and order:
            it = order[pos]
            if it["id"] in chosen:
                chosen.discard(it["id"])
                chosen -= {i["id"] for i in items if it["id"] in i.get("requires", [])}
            else:
                chosen.add(it["id"])
                chosen |= set(it.get("requires", []))
        elif k in (ord("p"), ord("P")):
            pi = (pi + 1) % len(presets)
            if presets[pi] != "custom":
                chosen = set(catalog["presets"][presets[pi]])
        elif k in ENTER:
            form_data["hub"] = [i["id"] for i in items if i["id"] in chosen]
            return
        elif k == 27:
            raise Back()


# ---- install screen -------------------------------------------------------------------------------
def draw_progress(ui, pct, stage, detail, eta):
    ui.s.erase()
    art = tui.pick_penguin(ui.h - 9)
    y = 1
    if art:
        y += ui.draw_penguin(y, art, pct / 100) + 1
    ui.center(y, f"{pct}%", fg=WHITE, bold=True)
    ui.center(y + 2, stage, fg=CYAN, bold=True)
    ui.center(y + 3, detail, fg=TEXT)
    if eta:
        ui.center(y + 4, f"About {eta} minute{'s' if eta != 1 else ''} left", fg=TEXT)
    ui.center(ui.h - 2, "Installing Axiom. Please keep the computer on.", fg=TEXT)
    ui.s.refresh()


def run_install(ui, form_data, disk, backend=None):
    """Run the install engine. backend is a fake engine command and is passed only by demo_install."""
    if backend is None and os.environ.get("AXIOM_FB_PNG") and os.geteuid() != 0:
        raise SystemExit("a preview run draws only; it cannot install")
    payload = dict(form_data, disk=disk["path"], disk_bytes=disk["size"])
    cmd = backend.split() if backend else [sys.executable, os.path.join(HERE, "axiom_install.py")]
    proc = subprocess.Popen(cmd, stdin=subprocess.PIPE,
                            stdout=subprocess.PIPE, text=True, env={**os.environ, **ai.ENV})
    proc.stdin.write(json.dumps(payload))
    proc.stdin.close()
    q = queue.Queue()
    def pump():
        for l in proc.stdout:
            q.put(l)
        q.put(None)
    threading.Thread(target=pump, daemon=True).start()
    pct, stage, detail, eta, msg, shown = 2, "Preparing the disk", "", None, "", 2.0
    ui.s.timeout(120)
    while True:
        try:
            line = q.get_nowait()
        except queue.Empty:
            line = ""
        if line is None:
            break
        if line:
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            pct = ev.get("pct", pct)
            stage = ev.get("stage", stage)
            detail = ev.get("detail", detail)
            eta = ev.get("eta_min", eta)
            msg = ev.get("message", msg)
            continue
        shown += (pct - shown) * 0.25  # ease the penguin towards the real value
        draw_progress(ui, int(round(shown)), stage, detail, eta)
        ui.s.getch()  # paces the loop (120 ms) and swallows stray keys
    ui.s.timeout(-1)
    rc = proc.wait()
    ui.s.erase()
    art = tui.pick_penguin(ui.h - 10)
    y = 1
    if rc == 0:
        if art:
            y += ui.draw_penguin(y, art, 1.0) + 1
        ui.center(y, "Axiom is ready!", fg=GREEN, bold=True)
        ui.center(y + 2, "Remove the install disk or USB stick, then press Enter to restart.", fg=TEXT)
    else:
        if art:
            y += ui.draw_penguin(y, art, shown / 100) + 1
        ui.center(y, "The installation did not finish", fg=RED, bold=True)
        for i, line in enumerate(tui.wrap(msg or "Something went wrong.", min(ui.w - 8, 70))):
            ui.center(y + 2 + i, line, fg=TEXT)
        ui.center(y + 4, "You can go back and try again. Details: /var/log/axiom-installer.log", fg=TEXT)
    ui.footer("Press Enter to continue")
    ui.s.refresh()
    while ui.s.getch() not in ENTER:
        pass
    return rc == 0


# ---- flow -----------------------------------------------------------------------------------------
def probe(f):
    """A fully valid base so one screen's validation only checks the fields it owns."""
    return {"username": f["username"] or "probe", "fullname": f["fullname"] or "Probe", "hostname": f["hostname"],
            "password": f["password"] or "probe-password-1", "timezone": f["timezone"], "keyboard": f["keyboard"],
            "locale": f["locale"], "git_name": f["git_name"], "git_email": f["git_email"]}


def start_setup(ui):
    catalog = load_catalog()
    f = {"fullname": "", "username": "", "hostname": "axiom", "password": "", "password2": "",
         "timezone": os.environ.get("AXIOM_TZ", "UTC"), "keyboard": "us", "locale": "en_US", "git_name": "",
         "git_email": "", "luks": False, "luks_passphrase": "", "hub": []}
    disk_choice, step, total = {"value": ""}, 1, 6
    while True:
        try:
            if step == 1:
                fs = [{"key": "locale", "label": "Language", "kind": "choice", "choices": LOCALES, "names": LOCALE_NAMES,
                       "value": f["locale"], "hint": "Left/Right change. You can change this later in Settings."},
                      {"key": "keyboard", "label": "Keyboard", "kind": "choice", "choices": KEYMAPS, "names": KEYMAP_NAMES,
                       "value": f["keyboard"], "hint": "Left/Right change. Pick the layout printed on your keys."}]
                fs += tz_fields(tz_groups(), f["timezone"])

                def v_when():
                    ai.validate_form(dict(probe(f), locale=fs[0]["value"], keyboard=fs[1]["value"],
                                          timezone=tz_name(fs[2]["value"], fs[3]["value"])))
                form(ui, step, total, "Language and time", "Tell Axiom how you type and where you are. "
                     "You can change these later in Settings.", fs, v_when)
                f["locale"], f["keyboard"] = fs[0]["value"], fs[1]["value"]
                f["timezone"] = tz_name(fs[2]["value"], fs[3]["value"])
            elif step == 2:
                disks = ai.list_disks()
                if not disks:
                    form(ui, step, total, "Choose a disk", "Axiom can't find a disk to install on. Disks that are in "
                         "use, removable or read-only are hidden.", [], lambda: (_ for _ in ()).throw(
                             ai.FormError("No usable disk found. Connect a disk and restart the installer.")))
                labels = [f"{d['path']}   {d['size'] / 2 ** 30:.0f} GB   {d['model']}".rstrip() for d in disks]
                fs = [{"key": "disk", "label": "Install on", "kind": "choice", "choices": labels,
                       "value": disk_choice["value"] if disk_choice["value"] in labels else labels[0]},
                      {"key": "luks", "label": "Protect with a password", "kind": "toggle", "value": f["luks"],
                       "hint": "Encrypts the disk so nobody can read your files without the password."},
                      {"key": "luks_passphrase", "label": "Disk password", "kind": "password",
                       "value": f["luks_passphrase"], "show": lambda: fs[1]["value"],
                       "hint": "You type this every time the computer starts. If you forget it, your files "
                               "cannot be recovered."}]

                def v_disk():
                    if disks[labels.index(fs[0]["value"])]["size"] < 10 * 2 ** 30:
                        raise ai.FormError("This disk is too small. Axiom needs at least 10 GB.")
                    if fs[1]["value"]:
                        ai.check_password(fs[2]["value"])
                form(ui, step, total, "Choose a disk", "Axiom will use the whole disk. Everything on it will be "
                     "erased.", fs, v_disk)
                disk_choice["value"] = fs[0]["value"]
                f["luks"], f["luks_passphrase"] = fs[1]["value"], fs[2]["value"] if fs[1]["value"] else ""
                f["_disk"] = disks[labels.index(fs[0]["value"])]
            elif step == 3:
                fs = [{"key": "fullname", "label": "Your name", "value": f["fullname"]},
                      {"key": "username", "label": "Username", "value": f["username"],
                       "hint": "Used to log in. Lowercase letters, numbers, - and _ only."},
                      {"key": "hostname", "label": "Name of this computer", "value": f["hostname"],
                       "hint": "Shown on your network. Lowercase letters, numbers and - only."},
                      {"key": "password", "label": "Password", "kind": "password", "value": f["password"],
                       "hint": "At least 10 characters. Avoid common words."},
                      {"key": "password2", "label": "Repeat password", "kind": "password", "value": f["password2"]}]

                def v_acct():
                    d = {x["key"]: x["value"] for x in fs}
                    if d["password"] != d["password2"]:
                        raise ai.FormError("The two passwords are different.")
                    ai.validate_form(dict(probe(f), **d))
                form(ui, step, total, "Create your account", "This account can manage the computer. "
                     "The built-in administrator account stays locked.", fs, v_acct)
                f.update({x["key"]: x["value"] for x in fs})
            elif step == 4:
                fs = [{"key": "git_name", "label": "Name for Git", "value": f["git_name"]},
                      {"key": "git_email", "label": "Email for Git", "value": f["git_email"],
                       "hint": "Leave both empty if you don't use Git."}]
                form(ui, step, total, "Git identity (optional)", "For developers: the name and email your code "
                     "commits will show. You sign in to GitHub after the first start.", fs,
                     lambda: ai.validate_form(dict(probe(f), **{x["key"]: x["value"] for x in fs})))
                f.update({x["key"]: x["value"] for x in fs})
            elif step == 5:
                hub(ui, step, total, f, catalog)
            elif step == 6:
                d = f["_disk"]
                rows = [("Disk", f"{d['path']}  ({d['size'] / 2 ** 30:.0f} GB)  - will be erased"),
                        ("Protection", "Password-protected disk" if f["luks"] else "None"),
                        ("Account", f"{f['fullname']}  ({f['username']})"),
                        ("Computer", f["hostname"]),
                        ("Language", f"{f['locale']}   keyboard {f['keyboard']}   {f['timezone']}"),
                        ("Git", f"{f['git_name']} <{f['git_email']}>" if f["git_name"] else "Not set"),
                        ("Tools", ", ".join(f["hub"]) or "None")]
                fs = [{"key": "confirm", "label": "Type ERASE to start", "value": "",
                       "hint": f"This permanently deletes everything on {d['path']}."}]

                def v_confirm():
                    if fs[0]["value"] != "ERASE":
                        raise ai.FormError("Type ERASE in capital letters to continue.")
                intro = "\n".join(f"{k:<12}{v}" for k, v in rows)
                form(ui, step, total, "Check and install", intro, fs, v_confirm,
                     "Enter  install now      Esc  go back")
                payload = {k: v for k, v in f.items() if k != "_disk"}
                ai.validate_form(payload)
                return run_install(ui, payload, f["_disk"])
            step += 1
        except Back:
            if step == 1:
                return False
            step -= 1


def shell(ui, banner):
    tui.endwin()
    tui.restore_console()
    os.system("clear")
    print(banner)
    subprocess.call(["/bin/zsh" if os.path.exists("/bin/zsh") else "/bin/sh"], env={**os.environ, **ai.ENV})
    tui.setup_console()
    ui.s.refresh()


def main(scr):
    ui = tui.UI(scr)
    while True:
        try:
            i = menu(ui, "Welcome to Axiom!",
                     [("Install Axiom", "Set up this computer. It takes about 15 minutes and needs internet."),
                      ("Advanced options", "Recovery tools, a terminal, or restart.")],
                     "Let's get your computer ready. First you'll answer a few simple questions.")
        except Back:
            continue
        if i == 0:
            if start_setup(ui):
                tui.endwin()
                os.execvp("systemctl", ["systemctl", "reboot"])
        else:
            try:
                j = menu(ui, "Advanced options",
                         [("Recovery tools", "Open a shell with disk tools (lsblk, cryptsetup, mount, btrfs)."),
                          ("Open a terminal", "A plain shell on the install medium."),
                          ("Restart", "Restart the computer.")], "", penguin_fill=0.0)
            except Back:
                continue
            if j == 0:
                shell(ui, "Axiom recovery shell. Useful: lsblk, cryptsetup open, mount, btrfs, arch-chroot. "
                          "Type exit to return.")
            elif j == 1:
                shell(ui, "Axiom live shell. Type exit to return to the installer.")
            else:
                tui.endwin()
                os.execvp("systemctl", ["systemctl", "reboot"])


def demo_install(scr):
    """Test seam (--demo-install): the real install screen driven by AXIOM_BACKEND_CMD (no disk is touched)."""
    ui = tui.UI(scr)
    run_install(ui, {"demo": True}, {"path": "/dev/null", "size": 0}, backend=os.environ.get("AXIOM_BACKEND_CMD"))


def demo_progress(scr):
    """Visual check only: animates the install screen with fake numbers; writes nothing."""
    ui = tui.UI(scr)
    stages = [("Preparing the disk", ""), ("Downloading Axiom", "340 MiB downloaded at 2.9 MiB/s"),
              ("Installing the system", "Package 48 of 159: firefox"), ("Setting up startup", "")]
    if os.environ.get("AXIOM_DEMO_PCT"):  # one frozen frame, for screenshots
        pct = int(os.environ["AXIOM_DEMO_PCT"])
        st = stages[min(3, pct // 28)]
        draw_progress(ui, pct, st[0], st[1], 6)
        time.sleep(float(os.environ.get("AXIOM_DEMO_HOLD", "3")))
        return
    for p in range(0, 101, 2):
        st = stages[min(3, p // 28)]
        draw_progress(ui, p, st[0], st[1], max(1, (100 - p) // 9) if p > 12 else None)
        time.sleep(0.12)
    time.sleep(float(os.environ.get("AXIOM_DEMO_HOLD", "3")))


if __name__ == "__main__":
    os.environ.setdefault("ESCDELAY", "50")
    if os.geteuid() != 0 and not os.environ.get("AXIOM_FB_PNG"):  # PNG previews draw only, no install
        sys.exit("axiom-installer must run as root on the install medium")
    tui.setup_console(preview="--demo-progress" in sys.argv or "--demo-install" in sys.argv)
    try:
        tui.run(demo_install if "--demo-install" in sys.argv else
                demo_progress if "--demo-progress" in sys.argv else main)
    finally:
        tui.restore_console()
