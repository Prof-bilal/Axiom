# ContextGit local run state (machine-local SQLite database and WAL/SHM files).
# .contextgit/context.md is tracked; the database is not.
.contextgit/*.db
.contextgit/*.db-shm
.contextgit/*.db-wal

# Editor and OS noise
.DS_Store
*.swp
*~

# Phase 1 ISO build artifacts (regenerated; never commit)
iso/work*/
iso/out/
*.iso
*.iso.sha256
*.qcow2
serial.log
OVMF_VARS*.fd
vm-vars.fd

# Python bytecode
__pycache__/
*.pyc
