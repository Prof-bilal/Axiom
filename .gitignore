# ContextGit local run state (machine-local SQLite database and WAL/SHM files).
# .contextgit/context.md is tracked; the database is not.
.contextgit/*.db
.contextgit/*.db-shm
.contextgit/*.db-wal

# Editor and OS noise
.DS_Store
.vscode/
# Local agent-tool settings (machine-specific permissions), not project files
.commandcode/
*.swp
*~

# ISO build artifacts (regenerated; never commit)
iso/work*/
iso/out*/
*.iso
*.iso.sha256
*.qcow2
serial.log
OVMF_VARS*.fd
vm-vars.fd

# Phase 3 research: cloned reference repositories are read-only research
# material, never product dependencies. Pins are recorded in
# research/phase3/repos.lock; only analysis artifacts are committed.
research/phase3/repos/
research/phase3/rea/

# Python bytecode
__pycache__/
*.pyc

# Local multi-project workspace: sibling first-party repos cloned for
# cross-project work. Not part of Axiom; never commit them here.
workspace/
