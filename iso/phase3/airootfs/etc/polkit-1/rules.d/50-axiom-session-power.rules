// Axiom Phase 3 session power control.
//
// The Axiom Shell session menu calls `systemctl poweroff|reboot` as the
// unprivileged desktop user (shell/services/PowerService.qml). logind treats
// the request as a multi-session power-off whenever any other login session
// exists (the live image always has the serial-console getty), and polkit
// reserves that for administrators, so Shut Down and Restart would be denied
// with "interactive authentication required".
//
// Allow exactly that: the desktop user, in a local, active session. No other
// user, remote or inactive session, and no other action is affected. Suspend,
// hibernate and inhibitor-ignoring variants keep their stock policy.
polkit.addRule(function (action, subject) {
    var multi = {
        "org.freedesktop.login1.power-off-multiple-sessions": true,
        "org.freedesktop.login1.reboot-multiple-sessions": true
    };
    if (multi[action.id] && subject.user == "axiom" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
