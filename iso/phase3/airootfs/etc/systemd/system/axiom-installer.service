[Unit]
Description=Axiom boot installer
ConditionKernelCommandLine=axiom.installer
After=systemd-user-sessions.service plymouth-quit-wait.service getty-pre.target
Before=getty.target

[Service]
Type=simple
Environment=TERM=linux
ExecStart=/usr/local/bin/axiom-installer
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Restart=always
RestartSec=1

[Install]
WantedBy=getty.target
