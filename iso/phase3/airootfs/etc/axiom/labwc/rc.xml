<?xml version="1.0"?>
<!--
  Axiom Phase 3 compositor harness: labwc configuration (ADR-016).

  labwc is a temporary, replaceable harness behind the Axiom session adapter,
  not the Axiom product contract. It provides the protocols the shell uses
  (wlr-layer-shell, wlr/ext foreign-toplevel, ext-workspace) plus server-side
  window decorations themed as Axiom (theme "Axiom",
  /usr/local/share/themes/Axiom/labwc/themerc).

  Visual rules mirror docs/DESKTOP_DESIGN.md.
-->
<labwc_config>

  <core>
    <decoration>server</decoration>
    <gap>10</gap>
  </core>

  <!-- New windows open centred on the active output; later ones shift
       down-right so they never hide an existing window exactly. -->
  <placement>
    <policy>cascade</policy>
    <cascadeOffset x="32" y="32" />
  </placement>

  <theme>
    <name>Axiom</name>
    <icon>Adwaita</icon>
    <fallbackAppIcon>application-x-executable</fallbackAppIcon>
    <titlebar>
      <layout>icon:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <cornerRadius>12</cornerRadius>
    <keepBorder>yes</keepBorder>
    <maximizedDecoration>titlebar</maximizedDecoration>
    <dropShadows>yes</dropShadows>
    <dropShadowsOnTiled>no</dropShadowsOnTiled>
    <font place="ActiveWindow"><name>Inter</name><size>10</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>Inter</name><size>10</size><weight>bold</weight></font>
    <font place="MenuHeader"><name>Inter</name><size>10</size><weight>bold</weight></font>
    <font place="MenuItem"><name>Inter</name><size>10</size></font>
    <font place="OnScreenDisplay"><name>Inter</name><size>10</size></font>
  </theme>

  <windowSwitcher preview="yes" outlines="yes">
    <osd show="yes" style="classic" output="all" />
    <fields>
      <field content="icon" width="5%" />
      <field content="desktop_entry_name" width="30%" />
      <field content="title" width="65%" />
    </fields>
  </windowSwitcher>

  <!-- The Axiom panel shows workspace state, so no compositor OSD. -->
  <desktops>
    <popupTime>0</popupTime>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
    </names>
  </desktops>

  <focus>
    <followMouse>no</followMouse>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <keyboard>
    <repeatRate>25</repeatRate>
    <repeatDelay>600</repeatDelay>

    <!-- applications -->
    <keybind key="W-Return"><action name="Execute" command="axiom-terminal" /></keybind>

    <!-- Axiom Shell surfaces (IPC addressed by config path) -->
    <keybind key="W-d"><action name="Execute" command="qs ipc -p /usr/local/share/axiom/shell call axiom toggleLauncher" /></keybind>
    <keybind key="W-a"><action name="Execute" command="qs ipc -p /usr/local/share/axiom/shell call axiom toggleAxiomMenu" /></keybind>
    <keybind key="W-s"><action name="Execute" command="qs ipc -p /usr/local/share/axiom/shell call axiom toggleActivities" /></keybind>
    <keybind key="W-n"><action name="Execute" command="qs ipc -p /usr/local/share/axiom/shell call axiom toggleNotificationCenter" /></keybind>
    <keybind key="W-c"><action name="Execute" command="qs ipc -p /usr/local/share/axiom/shell call axiom toggleControlCenter" /></keybind>
    <keybind key="W-S-e"><action name="Execute" command="qs ipc -p /usr/local/share/axiom/shell call axiom toggleSessionMenu" /></keybind>

    <!-- windows -->
    <keybind key="W-q"><action name="Close" /></keybind>
    <keybind key="A-F4"><action name="Close" /></keybind>
    <keybind key="W-m"><action name="ToggleMaximize" /></keybind>
    <keybind key="W-f"><action name="ToggleFullscreen" /></keybind>
    <keybind key="W-h"><action name="Iconify" /></keybind>
    <keybind key="A-Tab"><action name="NextWindow" /></keybind>
    <keybind key="A-S-Tab"><action name="PreviousWindow" /></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" /></keybind>
    <keybind key="W-Up"><action name="SnapToEdge" direction="up" /></keybind>
    <keybind key="W-Down"><action name="SnapToEdge" direction="down" /></keybind>

    <!-- workspaces -->
    <keybind key="W-1"><action name="GoToDesktop" to="1" /></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2" /></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3" /></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4" /></keybind>
    <keybind key="W-S-1"><action name="SendToDesktop" to="1" /></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2" /></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3" /></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4" /></keybind>
  </keyboard>
</labwc_config>
