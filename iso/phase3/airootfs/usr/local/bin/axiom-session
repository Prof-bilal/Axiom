#!/bin/sh
# Axiom session startup (Phase 3).
#
# login (agetty/autologin -> logind session) -> axiom-session -> compositor
# harness -> Axiom Shell (Quickshell), started by the compositor's autostart.
#
# Compositor: labwc (ADR-016, /etc/axiom/labwc) by default. Hyprland (ADR-029,
# /etc/axiom/hypr/hyprland.lua) is opt-in: write "hyprland" to /etc/axiom/compositor.
# If an opted-in Hyprland stops within 15 s (no usable GL) the session starts
# labwc instead, so the machine still gets a desktop.
#
# Runs as the unprivileged login user. The compositor is a disposable bring-up
# harness behind the session adapter, not the Axiom product contract.

export XDG_CURRENT_DESKTOP=Axiom
export XDG_SESSION_DESKTOP=axiom
export XDG_SESSION_TYPE=wayland
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
# ~/.local/bin holds commands installed with npm (--prefix ~/.local) and pipx.
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"
# The Hub installs Flatpaks with --user; their .desktop files and icons live under the flatpak
# exports dirs, which greetd sessions do not get from /etc/profile.d. Without them the launcher
# shows no icon (or no entry) for Hub-installed apps.
export XDG_DATA_DIRS="$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
# Lets `qs ipc call axiom …` from any session process find the Axiom Shell.
export QS_CONFIG_PATH=/usr/local/share/axiom/shell

# Axiom cursor theme (generated by scripts/gen-cursors.py); Wayland clients read these.
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24

# Software rendering is forced only inside a virtual machine (QEMU/KVM, no hardware
# accel); on real hardware the GPU is used. Applied per compositor below.
if systemd-detect-virt -q 2>/dev/null; then axiom_virt=1; else axiom_virt=0; fi
export MOZ_ENABLE_WAYLAND=1
# Every app gets the compositor's Axiom title bar, not its own: toolkits that
# draw client-side decorations are asked to use server-side ones (labwc draws
# the Axiom close, minimise and maximise buttons). Apps that ignore these hints
# keep their own bar; Firefox also has browser.tabs.inTitlebar=0 in the profile.
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export GTK_CSD=0

# Appearance: "light" or "dark" from the user's setting; dark is the default.
# An explicit AXIOM_THEME in the environment wins (used by development runs).
if [ -z "${AXIOM_THEME:-}" ]; then
  AXIOM_THEME=dark
  if [ -r "$HOME/.config/axiom/theme" ]; then
    read -r axiom_theme_setting < "$HOME/.config/axiom/theme" || true
    case "${axiom_theme_setting:-}" in light|dark) AXIOM_THEME=$axiom_theme_setting ;; esac
  fi
fi
export AXIOM_THEME
export QT_QPA_PLATFORM=wayland


# The freedesktop Trash directories must exist before any GVfs daemon or file
# manager watches the trash: a GVfs trash daemon that starts while they are
# missing never notices items trashed afterwards, so the Trash view stays
# empty until it is restarted (reproduced in QEMU). Created private (0700).
( umask 077
  data="${XDG_DATA_HOME:-$HOME/.local/share}"
  mkdir -p -- "$data/Trash/files" "$data/Trash/info" ) 2>/dev/null || true
# The desktop shows ~/Desktop; it must exist before the shell lists it.
mkdir -p -- "$HOME/Desktop" 2>/dev/null || true

# Keyboard layout chosen in Settings (Phase 5). labwc reads XKB_* only at start,
# so it is applied here. Only strictly shaped values are accepted; anything else
# in the file is ignored.
kb="${XDG_CONFIG_HOME:-$HOME/.config}/axiom/keyboard.env"
if [ -r "$kb" ]; then
  layout=$(sed -n 's/^XKB_DEFAULT_LAYOUT=\([a-z0-9_]\{2,12\}\(,[a-z0-9_]\{2,12\}\)\{0,1\}\)$/\1/p' "$kb" | head -n 1)
  opts=$(sed -n 's/^XKB_DEFAULT_OPTIONS=\(grp:alt_shift_toggle\)$/\1/p' "$kb" | head -n 1)
  [ -n "$layout" ] && export XKB_DEFAULT_LAYOUT="$layout"
  [ -n "$opts" ] && export XKB_DEFAULT_OPTIONS="$opts"
fi

echo "AXIOM_SESSION_START" > /dev/ttyS0 2>/dev/null || true

# Announce shell readiness on the serial console so QEMU can capture evidence
# of a real graphical session rather than assuming one started.
(
  i=0
  while [ "$i" -lt 120 ]; do
    if pgrep -x quickshell >/dev/null 2>&1; then
      sleep 2
      echo "AXIOM_SHELL_READY" > /dev/ttyS0 2>/dev/null || true
      break
    fi
    i=$((i + 1))
    sleep 0.5
  done
) &

# The shell supervisor stops when this PID is gone. It stays the same whether
# labwc runs to the end of the session or Hyprland is exec'd instead.
export AXIOM_SESSION_PID=$$

# labwc is the default compositor (ADR-016). /etc/axiom/compositor containing
# "hyprland" opts in to Hyprland (/etc/axiom/hypr/hyprland.lua); if Hyprland stops
# within 15 s (no usable GL) the session starts labwc instead. The shell reads
# AXIOM_COMPOSITOR, never a compositor-specific variable.
start_labwc() {
  export AXIOM_COMPOSITOR=labwc
  unset HYPRLAND_INSTANCE_SIGNATURE
  if [ "$axiom_virt" = 1 ]; then
    export LIBGL_ALWAYS_SOFTWARE=1
    export WLR_RENDERER="${WLR_RENDERER:-pixman}"
  fi
  # Light mode picks the Axiom-Light theme. labwc reads the theme name only from
  # rc.xml at start, so use a generated copy of the config for that mode.
  if [ "$AXIOM_THEME" = light ]; then
    lcfg="${XDG_RUNTIME_DIR:-/tmp}/axiom-labwc-light"
    mkdir -p "$lcfg"
    sed 's|<name>Axiom</name>|<name>Axiom-Light</name>|' /etc/axiom/labwc/rc.xml > "$lcfg/rc.xml"
    cp /etc/axiom/labwc/menu.xml /etc/axiom/labwc/autostart "$lcfg/" 2>/dev/null || true
    exec dbus-run-session -- labwc -C "$lcfg"
  fi
  exec dbus-run-session -- labwc -C /etc/axiom/labwc
}

if [ "$(cat /etc/axiom/compositor 2>/dev/null)" = hyprland ] \
   && command -v start-hyprland >/dev/null 2>&1; then
  started=$(date +%s)
  (
    export AXIOM_COMPOSITOR=hyprland
    [ "$axiom_virt" = 1 ] && export LIBGL_ALWAYS_SOFTWARE=1
    exec dbus-run-session -- start-hyprland -- -c /etc/axiom/hypr/hyprland.lua
  )
  # A session that ran is a session that ended: do not start a second one.
  [ $(( $(date +%s) - started )) -ge 15 ] && exit 0
  # A shell started by the failed attempt would run beside labwc's own.
  pkill -u "$(id -u)" -f /usr/local/bin/axiom-shell 2>/dev/null
  pkill -u "$(id -u)" -x quickshell 2>/dev/null
  echo "AXIOM_COMPOSITOR_FALLBACK labwc" > /dev/ttyS0 2>/dev/null || true
fi

start_labwc
