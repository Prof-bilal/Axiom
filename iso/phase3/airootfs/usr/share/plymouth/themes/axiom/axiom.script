# Axiom Plymouth splash. Real progress only (no fake bar, unlike the Omarchy reference).
Window.SetBackgroundTopColor(0.031, 0.047, 0.055);
Window.SetBackgroundBottomColor(0.031, 0.047, 0.055);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetHeight() / 2 - logo.image.GetHeight() / 2;
logo.sprite.SetPosition(logo.x, logo.y, 0);

# Real boot progress, drawn as a thin bar under the logo.
bar.sprite = Sprite();
bar.y = logo.y + logo.image.GetHeight() + 24;
bar.width = Window.GetWidth() / 4;
fun boot_progress_callback(duration, progress) {
  if (progress > 1.0) progress = 1.0;
  bar.image = Image.Rectangle(Math.Int(bar.width * progress) + 1, 4, 0.0, 0.8, 0.85);
  bar.sprite.SetImage(bar.image);
  bar.sprite.SetPosition(Window.GetWidth() / 2 - bar.width / 2, bar.y, 1);
}
Plymouth.SetBootProgressFunction(boot_progress_callback);

# Gentle bob of the penguin (about 6 px, ~2 s period).
global.frame = 0;
fun refresh_callback() {
  global.frame++;
  logo.sprite.SetPosition(logo.x, logo.y + Math.Sin(global.frame / 50.0 * 3.14159) * 6, 0);
}
Plymouth.SetRefreshFunction(refresh_callback);

# LUKS passphrase: a visible prompt on the same screen, with one bullet per character typed.
prompt.sprite = Sprite();
prompt.y = bar.y + 32;
fun display_password_callback(text, bullets) {
  stars = "";
  for (i = 0; i < bullets; i++) stars += "*";
  prompt.image = Image.Text(text + " " + stars, 0.9, 0.95, 0.96);
  prompt.sprite.SetImage(prompt.image);
  prompt.sprite.SetPosition(Window.GetWidth() / 2 - prompt.image.GetWidth() / 2, prompt.y, 2);
}
fun display_normal_callback() {
  prompt.sprite.SetImage(Image.Text("", 0, 0, 0));
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
