# Axiom Plymouth splash: glowing penguin, wordmark, a turning ring and a thin
# bar that shows real boot progress (never a fake one). LUKS passphrase prompt
# is drawn on the same screen.
Window.SetBackgroundTopColor(0.020, 0.028, 0.035);
Window.SetBackgroundBottomColor(0.031, 0.047, 0.055);

W = Window.GetWidth();
H = Window.GetHeight();
cx = W / 2;

# Penguin, a little above the middle.
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = cx - logo.image.GetWidth() / 2;
logo.y = H / 2 - 230;
logo.sprite.SetPosition(logo.x, logo.y, 0);

# Wordmark under the penguin.
word.image = Image("wordmark.png");
word.sprite = Sprite(word.image);
word.y = logo.y + logo.image.GetHeight() + 14;
word.sprite.SetPosition(cx - word.image.GetWidth() / 2, word.y, 1);

# "LOADING SYSTEM..." caption.
cap.image = Image.Text("LOADING SYSTEM...", 1.0, 0.70, 0.28, 1.0);
cap.sprite = Sprite(cap.image);
cap.y = word.y + word.image.GetHeight() + 14;
cap.sprite.SetPosition(cx - cap.image.GetWidth() / 2, cap.y, 1);

# Turning ring.
ring.image = Image("ring.png");
ring.sprite = Sprite(ring.image);
ring.y = cap.y + cap.image.GetHeight() + 26;
ring.sprite.SetPosition(cx - ring.image.GetWidth() / 2, ring.y, 1);

# Real boot progress, a thin bar under the ring.
bar.sprite = Sprite();
bar.y = ring.y + ring.image.GetHeight() + 26;
bar.width = W / 5;
fun boot_progress_callback(duration, progress) {
  if (progress > 1.0) progress = 1.0;
  bar.image = Image.Rectangle(Math.Int(bar.width * progress) + 1, 3, 1.0, 0.58, 0.09);
  bar.sprite.SetImage(bar.image);
  bar.sprite.SetPosition(cx - bar.width / 2, bar.y, 1);
}
Plymouth.SetBootProgressFunction(boot_progress_callback);

# Animation: the ring turns and the penguin bobs (about 6 px, ~2 s period).
global.frame = 0;
fun refresh_callback() {
  global.frame++;
  ring.sprite.SetImage(ring.image.Rotate(global.frame * 0.12));
  ring.sprite.SetPosition(cx - ring.image.GetWidth() / 2, ring.y, 1);
  logo.sprite.SetPosition(logo.x, logo.y + Math.Sin(global.frame / 50.0 * 3.14159) * 6, 0);
}
Plymouth.SetRefreshFunction(refresh_callback);

# LUKS passphrase: a visible prompt on the same screen, one bullet per character typed.
prompt.sprite = Sprite();
prompt.y = bar.y + 32;
fun display_password_callback(text, bullets) {
  stars = "";
  for (i = 0; i < bullets; i++) stars += "*";
  prompt.image = Image.Text(text + " " + stars, 0.9, 0.95, 0.96);
  prompt.sprite.SetImage(prompt.image);
  prompt.sprite.SetPosition(cx - prompt.image.GetWidth() / 2, prompt.y, 2);
}
fun display_normal_callback() {
  prompt.sprite.SetImage(Image.Text("", 0, 0, 0));
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
