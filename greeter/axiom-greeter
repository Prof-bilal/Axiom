#!/usr/bin/env python3
"""Axiom login screen: a console greeter for greetd (Phase 6, ADR-020).

greetd runs this as the unprivileged `greeter` user. It only forwards what the user types to greetd
(create_session -> PAM -> start_session); the password is never stored, logged or echoed. Only local
human accounts are listed. The look comes from axiom_tui (shared with the installer).
"""
import curses
import json
import os
import pwd
import socket
import struct
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
for p in ("/usr/local/lib/axiom-tui", os.path.join(HERE, "..", "tui")):
    if os.path.isdir(p):
        sys.path.insert(0, p)
import axiom_tui as tui  # noqa: E402
from axiom_tui import BG, CYAN, GHOST, GREEN, RED, TEXT, WHITE  # noqa: E402

SESSION_CMD = ["/usr/local/bin/axiom-session"]
SESSION_ENV = ["XDG_SESSION_TYPE=wayland", "XDG_SESSION_DESKTOP=axiom", "XDG_CURRENT_DESKTOP=Axiom"]
WRONG = "That password didn't work. Try again."
ENTER = (10, 13, curses.KEY_ENTER)


# ---- accounts and greetd protocol -----------------------------------------------------------------
def human_users():
    return [p for p in pwd.getpwall() if 1000 <= p.pw_uid < 60000 and not p.pw_shell.endswith(("nologin", "false"))]


def display_name(p):
    return (p.pw_gecos.split(",")[0] or p.pw_name) if p else ""


def _read(s, n):
    buf = b""
    while len(buf) < n:
        chunk = s.recv(n - len(buf))
        if not chunk:
            raise ConnectionError("greetd closed the connection")
        buf += chunk
    return buf


def rpc(s, msg):
    data = json.dumps(msg).encode()
    s.sendall(struct.pack("=I", len(data)) + data)
    return json.loads(_read(s, struct.unpack("=I", _read(s, 4))[0]))


def authenticate(user, ask, show):
    """Drive greetd's PAM conversation. Returns None on success, 'cancelled', or a message to show."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(os.environ["GREETD_SOCK"])
    try:
        r = rpc(s, {"type": "create_session", "username": user})
        while r["type"] == "auth_message":
            if r["auth_message_type"] in ("secret", "visible"):
                answer = ask(r["auth_message"], r["auth_message_type"] == "secret")
                if answer is None:
                    rpc(s, {"type": "cancel_session"})
                    return "cancelled"
                r = rpc(s, {"type": "post_auth_message_response", "response": answer})
            else:
                show(r["auth_message"])
                r = rpc(s, {"type": "post_auth_message_response", "response": None})
        if r["type"] != "success":
            rpc(s, {"type": "cancel_session"})
            return friendly(r.get("description", ""))
        r = rpc(s, {"type": "start_session", "cmd": SESSION_CMD, "env": SESSION_ENV})
        return None if r["type"] == "success" else "Could not start your session. Try again."
    finally:
        s.close()


def friendly(text):
    """Turn PAM's wording into plain language; lock-out messages from faillock pass through."""
    low = (text or "").lower()
    if "lock" in low or "too many" in low or "temporar" in low:
        return "Too many wrong tries. Please wait a few minutes and try again."
    return WRONG


# ---- screen ---------------------------------------------------------------------------------------
class Login:
    def __init__(self, scr):
        self.ui = tui.UI(scr)
        self.host = socket.gethostname()
        self.msg, self.msg_color = "", TEXT
        self.dx = 0

    def draw(self, account, typed, prompt="Password", secret=True):
        ui = self.ui
        ui.s.erase()
        h, w = ui.h, ui.w
        art = tui.pick_penguin(h - 15)
        y = 1
        if art:
            y += ui.draw_penguin(y, art, 1.0) + 1
        cx = (w - 1) // 2 + self.dx
        def c(row, text, **kw):
            ui.put(row, max(0, cx - len(text) // 2), text, **kw)
        c(y, "Welcome back" if account else "Sign in", fg=CYAN, bold=True)
        if account:
            c(y + 1, display_name(account), fg=WHITE, bold=True)
            c(y + 2, f"{account.pw_name} @ {self.host}", fg=TEXT)
        bw = min(34, w - 8)
        shown = ("*" * len(typed) if secret else typed)[-(bw - 4):] + "_"
        c(y + 4, prompt, fg=TEXT)
        ui.put(y + 5, cx - bw // 2, " " + shown.ljust(bw - 1), fg=BG, bg=CYAN, bold=True)
        c(y + 7, " Sign in ", fg=CYAN, bold=True)
        if self.msg:
            c(y + 9, self.msg, fg=self.msg_color, bold=True)
        elif tui.capslock_on():
            c(y + 9, "Caps Lock is on", fg=RED, bold=True)
        ui.center(h - 3, time.strftime("%A, %d %B   %H:%M"), fg=TEXT)
        ui.center(h - 1, "F2  Not you?        F10  Restart or shut down", fg=TEXT)
        ui.s.refresh()

    def shake(self, account):
        for dx in (3, -3, 2, -2, 0):
            self.dx = dx
            self.draw(account, "")
            time.sleep(0.05)

    def read(self, account, prompt="Password", secret=True):
        """Returns the text, None for Esc, or 'switch' for F2."""
        typed = ""
        self.ui.s.timeout(500)  # lets the clock and Caps Lock warning refresh
        try:
            while True:
                self.draw(account, typed, prompt, secret)
                k = self.ui.s.getch()
                if k == -1:
                    continue
                self.msg = "" if self.msg_color != GREEN else self.msg
                if k in ENTER:
                    return typed
                if k in (curses.KEY_BACKSPACE, 127, 8):
                    typed = typed[:-1]
                elif k == 27:
                    return None
                elif k == curses.KEY_F2:
                    return "switch"
                elif k == curses.KEY_F1:
                    self.msg, self.msg_color = "Type your password and press Enter.", TEXT
                elif k in (curses.KEY_F10, 274):
                    self.power()
                elif 32 <= k < 127:
                    typed += chr(k)
        finally:
            self.ui.s.timeout(-1)

    def pick_user(self, users):
        """F2: choose another local account (or type a name)."""
        names = [(display_name(p), p) for p in users]
        items = names + [("Someone else...", None)]
        i = 0
        while True:
            ui = self.ui
            ui.s.erase()
            ui.center(3, "Who is signing in?", fg=CYAN, bold=True)
            for n, (label, _) in enumerate(items):
                ui.center(6 + n * 2, ("  " + label + "  ").center(30), fg=BG if n == i else WHITE,
                          bg=CYAN if n == i else BG, bold=True)
            ui.center(ui.h - 1, "Up/Down  move      Enter  choose      Esc  back", fg=TEXT)
            ui.s.refresh()
            k = ui.s.getch()
            if k == curses.KEY_UP:
                i = max(0, i - 1)
            elif k == curses.KEY_DOWN:
                i = min(len(items) - 1, i + 1)
            elif k in ENTER:
                return items[i][1] if items[i][1] is not None else "other"
            elif k == 27:
                return None

    def power(self):
        items = [("Cancel", None), ("Restart", "reboot"), ("Shut down", "poweroff")]
        i = 0
        while True:
            ui = self.ui
            ui.s.erase()
            ui.center(5, "Power", fg=CYAN, bold=True)
            for n, (label, _) in enumerate(items):
                ui.center(8 + n * 2, ("  " + label + "  ").center(24), fg=BG if n == i else WHITE,
                          bg=CYAN if n == i else BG, bold=True)
            ui.center(ui.h - 1, "Up/Down  move      Enter  choose      Esc  back", fg=TEXT)
            ui.s.refresh()
            k = ui.s.getch()
            if k == curses.KEY_UP:
                i = max(0, i - 1)
            elif k == curses.KEY_DOWN:
                i = min(2, i + 1)
            elif k in ENTER:
                if items[i][1]:
                    subprocess.run(["systemctl", items[i][1]], check=False)
                return
            elif k == 27:
                return


def main(scr):
    app = Login(scr)
    users = human_users()
    account = users[0] if len(users) == 1 else None
    while True:
        if account is None:
            choice = app.pick_user(users) if users else "other"
            if choice == "other":
                name = app.read(None, "Username", False)
                if not name or name == "switch":
                    continue
                account = _fake(name)
            elif choice is None:
                continue
            else:
                account = choice
        state = {"switch": False}

        def ask(prompt, secret):
            text = app.read(account, (prompt.strip().rstrip(":") or "Password"), secret)
            if text == "switch":
                state["switch"] = True
                return None
            return text

        def show(text):
            app.msg, app.msg_color = text, TEXT
        res = authenticate(account.pw_name, ask, show)
        if res is None:
            app.msg, app.msg_color = "Signing in...", GREEN
            app.draw(account, "")
            return
        if state["switch"] or res == "cancelled":
            account, app.msg = None, ""
        else:
            app.msg, app.msg_color = res, RED
            app.shake(account)


class _fake:
    """Minimal stand-in for a passwd entry when someone types an unlisted username."""
    def __init__(self, name):
        self.pw_name, self.pw_gecos = name, name


def preview(scr):
    """Visual check only (no greetd, no login): draws the screen in its normal and error states."""
    app = Login(scr)
    acct = type("A", (), {"pw_name": "abdullah", "pw_gecos": "Abdullah"})
    app.draw(acct, "hunter22")
    time.sleep(float(os.environ.get("AXIOM_PREVIEW_HOLD", "4")))
    app.msg, app.msg_color = WRONG, RED
    app.draw(acct, "")
    time.sleep(float(os.environ.get("AXIOM_PREVIEW_HOLD", "4")))


if __name__ == "__main__":
    os.environ.setdefault("ESCDELAY", "50")
    tui.setup_console()
    curses.wrapper(preview if "--preview" in sys.argv else main)
