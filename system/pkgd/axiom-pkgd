#!/bin/sh
# Privileged helper for Axiom App Installer: install one pacman package file.
# Runs only as root through pkexec, after polkit approves org.axiom.installer.install.
# Operations: install <abs path to .pkg.tar.*> (copied to a root-only dir first so it
# cannot be swapped after the check), sync <repo package>, remove <package>,
# approve <sha256> (admin approval for an unsigned user install, logged),
# snapshot <description>, update (snapshot then pacman -Syu), rollback <number>, snapshots (ADR-033).
# install/sync/remove snapshot first on an installed system; sync never does a partial upgrade (audit H4).
# Transactions hold a lock and run as the transient unit axiom-pkg-job; cancel stops it before the commit phase (ADR-037).
set -u

[ "$(id -u)" -eq 0 ] || { echo "axiom-pkgd: must run as root" >&2; exit 1; }
op=${1:-}

# One package transaction at a time (ADR-037). A second request is refused, not queued behind a root prompt.
# The unit name below is a second guard: systemd refuses a second unit with the same name.
LOCK=${AXIOM_PKGD_LOCK:-/run/axiom-pkgd.lock}
UNIT=axiom-pkg-job
take_lock() {
  exec 9>"$LOCK" && flock -n 9 || { echo "axiom-pkgd: another install or update is already running" >&2; exit 5; }
}

# The transaction's output is copied to a log as well as streamed. `systemd-run --pipe` sends the output to the caller
# and not to the journal, so cancel could not otherwise see which phase pacman is in once the Hub window (the caller)
# is gone. tee -p ignores SIGPIPE: a closed window must not kill pacman through a broken pipe.
RUNDIR=${AXIOM_PKGD_RUNDIR:-/run}
LOG=$RUNDIR/axiom-pkg-job.log
WRAP='log=$1; rc=$2; shift 2; { "$@"; echo $? > "$rc"; } 2>&1 | tee -p "$log"; exit "$(cat "$rc")"'

# Run a package transaction as a transient system unit: it keeps running if the Hub window closes (owner
# decision Q4) and `axiom-pkgd cancel` can stop it. Without systemd (tests, odd chroots) it runs directly.
job() {
  if [ -d "${AXIOM_PKGD_SYSTEMD_DIR:-/run/systemd/system}" ] && command -v systemd-run >/dev/null 2>&1; then
    # If a job is already running (its Hub window may be gone, which releases the lock) the new one must not truncate
    # the running job's log, which cancel reads.
    if systemctl is-active --quiet "$UNIT.service"; then
      echo "axiom-pkgd: an install or update is already running" >&2
      return 5
    fi
    : > "$LOG" || return 1
    systemd-run --unit="$UNIT" --collect --wait --pipe --quiet -- sh -c "$WRAP" sh "$LOG" "$LOG.rc" "$@"
  else
    : > "$LOG" || return 1
    sh -c "$WRAP" sh "$LOG" "$LOG.rc" "$@"
  fi
}

# Installed systems snapshot before any change so it can be undone; the live image has nothing to roll back to.
snapshot_before() {
  [ -d "${AXIOM_PKGD_LIVE_DIR:-/run/archiso}" ] && return 0
  command -v snapper >/dev/null 2>&1 || { echo "axiom-pkgd: snapshots are not available on this system" >&2; exit 3; }
  snapper -c root create --type single --description "before $1" || exit 1
}

case "$op" in install|update|rollback|sync|remove) take_lock ;; esac
case "$op" in
  install)
    src=${2:-}
    case "$src" in /*) ;; *) echo "axiom-pkgd: path must be absolute" >&2; exit 2 ;; esac
    case "$src" in *.pkg.tar.zst|*.pkg.tar.xz) ;; *) echo "axiom-pkgd: not a package file" >&2; exit 2 ;; esac
    [ -f "$src" ] && [ ! -L "$src" ] || { echo "axiom-pkgd: no such file" >&2; exit 2; }
    tmp=$(mktemp -d "${AXIOM_PKGD_TMP:-/run}/axiom-pkgd.XXXXXX") || exit 1
    cp -- "$src" "$tmp/package" || { rm -rf "$tmp"; exit 1; }
    # pacman -U checks <file>.sig next to the file; with LocalFileSigLevel = Required an unsigned or untrusted
    # package is refused (audit H3). The approved file name and digest go to the journal.
    [ -f "$src.sig" ] && [ ! -L "$src.sig" ] && cp -- "$src.sig" "$tmp/package.sig"
    logger -t axiom-pkgd "install $(basename -- "$src") sha256=$(sha256sum "$tmp/package" | cut -d' ' -f1) signed=$([ -f "$tmp/package.sig" ] && echo yes || echo no) uid=${PKEXEC_UID:-unknown}"
    snapshot_before install || { rm -rf "$tmp"; exit 1; }
    job pacman -U --noconfirm -- "$tmp/package"
    rc=$?
    rm -rf "$tmp"
    exit $rc
    ;;
  approve)
    # Admin approval for a user-scope install that is unsigned (ADR-032). Changes nothing:
    # the polkit prompt is the approval and the hash is logged for the audit trail.
    sha=${2:-}
    case "$sha" in *[!0-9a-f]*|"") echo "axiom-pkgd: invalid digest" >&2; exit 2 ;; esac
    [ "${#sha}" -eq 64 ] || { echo "axiom-pkgd: invalid digest" >&2; exit 2; }
    logger -t axiom-pkgd "approved unsigned user install sha256=$sha uid=${PKEXEC_UID:-unknown}"
    exit 0
    ;;
  snapshot|update|rollback|snapshots)
    # Snapshot-backed operations (ADR-033). snapper manages btrfs snapshots of the root.
    # A system without snapper cannot update or roll back: the helper refuses rather than
    # update without a way back.
    # update and rollback have their own polkit actions (axiom-pkg-update, axiom-pkg-rollback). The wrappers set
    # AXIOM_PKGD_VIA; pkexec clears the caller's environment, so approving "install" cannot reach them (audit S2).
    case "$op" in update|rollback)
      [ "${AXIOM_PKGD_VIA:-}" = wrapper ] || { echo "axiom-pkgd: $op must go through its own approval" >&2; exit 2; } ;;
    esac
    command -v snapper >/dev/null 2>&1 || { echo "axiom-pkgd: snapshots are not available on this system" >&2; exit 3; }
    case "$op" in
      snapshot)
        desc=${2:-}
        case "$desc" in ""|*[!A-Za-z0-9\ ._-]*) echo "axiom-pkgd: invalid description" >&2; exit 2 ;; esac
        [ "${#desc}" -le 60 ] || { echo "axiom-pkgd: description too long" >&2; exit 2; }
        exec snapper -c root create --type single --description "$desc"
        ;;
      update)
        # Snapshot first; only then a full upgrade. If the snapshot fails, nothing is upgraded.
        n=$(snapper -c root create --type single --description "before update" --print-number) || exit 1
        job pacman -Syu --noconfirm
        rc=$?
        # A failed update changed nothing worth returning to: drop its snapshot (audit R6).
        if [ $rc -ne 0 ]; then
          case "$n" in ""|*[!0-9]*) ;; *) snapper -c root delete "$n" ;; esac
        fi
        exit $rc
        ;;
      rollback)
        id=${2:-}
        case "$id" in ""|*[!0-9]*) echo "axiom-pkgd: invalid snapshot number" >&2; exit 2 ;; esac
        logger -t axiom-pkgd "rollback to snapshot $id requested uid=${PKEXEC_UID:-unknown}"
        # Our layout is classic (root is the @ subvolume); name the ambit so snapper does not have to detect it.
        snapper -c root --ambit classic rollback "$id" || exit $?
        # /boot is the ESP, outside the snapshot: put the restored kernels there (ADR-036, audit H5).
        "${AXIOM_BOOT_SYNC:-/usr/local/bin/axiom-boot-sync}" "$id" || { echo "axiom-pkgd: rolled back, but the boot files could not be synced; do not reboot" >&2; exit 4; }
        exit 0
        ;;
      snapshots)
        exec snapper -c root list --columns number,date,description
        ;;
    esac
    ;;
  sync|remove)
    pkg=${2:-}
    case "$pkg" in
      ""|-*|*[!a-z0-9@._+-]*) echo "axiom-pkgd: invalid package name" >&2; exit 2 ;;
    esac
    if [ "$op" = remove ]; then
      # Never remove what the system cannot boot or authorize without (audit S4).
      case "$pkg" in
        linux|linux-lts|linux-firmware|base|pacman|systemd|polkit|glibc|btrfs-progs|snapper|axiom|axiom-*)
          echo "axiom-pkgd: refusing to remove a core package" >&2; exit 2 ;;
      esac
    fi
    snapshot_before "$op"
    if [ "$op" = remove ]; then job pacman -Rns --noconfirm -- "$pkg"; exit $?; fi
    if [ -d "${AXIOM_PKGD_LIVE_DIR:-/run/archiso}" ]; then
      # Live image only: it ships no package lists and nothing persists, so a bare -Sy is harmless.
      job pacman -Sy --noconfirm --needed -- "$pkg"
    else
      # Installed: a database refresh without a full upgrade is an unsupported partial upgrade, so upgrade too.
      job pacman -Syu --noconfirm --needed -- "$pkg"
    fi
    exit $?
    ;;
  cancel)
    # Stop the running job, but only while pacman is still downloading. Killing it while it changes the system can
    # leave a half-installed package and a stale db.lck. Goes through the same polkit prompt as an install.
    systemctl is-active --quiet "$UNIT.service" || { echo "axiom-pkgd: no install is running" >&2; exit 7; }
    # Real pacman output when it is not a terminal (the log written by job): ":: Processing package changes..." starts
    # the commit, then "installing NAME..." per package. Checked against a real transaction (tests/apps/fixtures).
    # If the log cannot be read the phase is unknown, so cancel is refused rather than risked.
    [ -r "$LOG" ] || { echo "axiom-pkgd: cannot tell what the install is doing, not cancelling" >&2; exit 6; }
    if grep -Eq '^(:: Processing package changes|(installing|upgrading|removing|reinstalling) [^ ]+\.\.\.$)' "$LOG"; then
      echo "axiom-pkgd: too late to cancel, the system is being changed" >&2; exit 6
    fi
    logger -t axiom-pkgd "cancel requested uid=${PKEXEC_UID:-unknown}"
    systemctl stop "$UNIT.service" || exit 1
    # A stopped pacman can leave its database lock behind, which would make the next install fail. Safe to remove only
    # when no pacman is running: we hold the transaction lock and the unit is stopped, so only a pacman the user started
    # by hand could still be using it.
    if ! pgrep -x pacman >/dev/null 2>&1; then rm -f "${AXIOM_PKGD_DBLOCK:-/var/lib/pacman/db.lck}"; fi
    exit 0
    ;;
  *) echo "axiom-pkgd: unknown operation" >&2; exit 2 ;;
esac
