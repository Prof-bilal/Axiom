{
  "id": "sublime",
  "commands": [
    {
      "method": "apt (Debian/Ubuntu) key",
      "command": "wget -qO - https://download.sublimetext.com/sublimehq-pub.gpg | sudo tee /etc/apt/keyrings/sublimehq-pub.asc > /dev/null",
      "needs_root": true,
      "source": "https://www.sublimetext.com/docs/linux_repositories.html"
    },
    {
      "method": "apt (Debian/Ubuntu) repo",
      "command": "echo -e 'Types: deb\\nURIs: https://download.sublimetext.com/\\nSuites: apt/stable/\\nSigned-By: /etc/apt/keyrings/sublimehq-pub.asc' | sudo tee /etc/apt/sources.list.d/sublime-text.sources",
      "needs_root": true,
      "source": "https://www.sublimetext.com/docs/linux_repositories.html"
    },
    {
      "method": "apt (Debian/Ubuntu) install",
      "command": "sudo apt-get update && sudo apt-get install sublime-text",
      "needs_root": true,
      "source": "https://www.sublimetext.com/docs/linux_repositories.html"
    },
    {
      "method": "pacman (Arch) key",
      "command": "curl -O https://download.sublimetext.com/sublimehq-pub.gpg && sudo pacman-key --add sublimehq-pub.gpg && sudo pacman-key --lsign-key 8A8F901A && rm sublimehq-pub.gpg",
      "needs_root": true,
      "source": "https://www.sublimetext.com/docs/linux_repositories.html"
    },
    {
      "method": "pacman (Arch) repo",
      "command": "echo -e \"\\n[sublime-text]\\nServer = https://download.sublimetext.com/arch/stable/x86_64\" | sudo tee -a /etc/pacman.conf",
      "needs_root": true,
      "source": "https://www.sublimetext.com/docs/linux_repositories.html"
    },
    {
      "method": "pacman (Arch) install",
      "command": "sudo pacman -Syu sublime-text",
      "needs_root": true,
      "source": "https://www.sublimetext.com/docs/linux_repositories.html"
    },
    {
      "method": "dnf (Fedora) key",
      "command": "sudo rpm -v --import https://download.sublimetext.com/sublimehq-rpm-pub.gpg",
      "needs_root": true,
      "source": "https://www.sublimetext.com/docs/linux_repositories.html"
    },
    {
      "method": "dnf (Fedora 41+) repo",
      "command": "sudo dnf config-manager addrepo --from-repofile=https://download.sublimetext.com/rpm/stable/x86_64/sublime-text.repo",
      "needs_root": true,
      "source": "https://www.sublimetext.com/docs/linux_repositories.html"
    },
    {
      "method": "dnf (Fedora) install",
      "command": "sudo dnf install sublime-text",
      "needs_root": true,
      "source": "https://www.sublimetext.com/docs/linux_repositories.html"
    },
    {
      "method": "download",
      "command": "download https://download.sublimetext.com/sublime_text_build_4215_x64.tar.xz (portable tarball; signature at .asc, key https://download.sublimetext.com/sublimehq-pub.gpg)",
      "needs_root": false,
      "source": "https://www.sublimetext.com/download_thanks?target=linux"
    }
  ],
  "status": "verified",
  "note": "Repo setup and install commands read from Sublime's official Linux repositories page; the tarball/deb download links come from the official download page."
}