{"id": "zoom", "commands": [{"method": "download package from Download Center (deb or rpm)", "command": "download https://zoom.us/download?os=linux", "needs_root": false, "source": "https://support.zoom.com/hc/en/article?id=zm_kb&sysparm_article=KB0063458"}, {"method": "apt (Debian/Ubuntu/Linux Mint): install GDebi", "command": "sudo apt install gdebi", "needs_root": true, "source": "https://support.zoom.com/hc/en/article?id=zm_kb&sysparm_article=KB0063458"}, {"method": "apt (Debian/Ubuntu/Linux Mint): install downloaded DEB", "command": "sudo apt install ./zoom_amd64.deb", "needs_root": true, "source": "https://support.zoom.com/hc/en/article?id=zm_kb&sysparm_article=KB0063458"}, {"method": "apt: refresh package database if dependencies are missing", "command": "sudo apt update", "needs_root": true, "source": "https://support.zoom.com/hc/en/article?id=zm_kb&sysparm_article=KB0063458"}, {"method": "zypper (openSUSE): install downloaded RPM", "command": "sudo zypper install zoom_openSUSE_x86_64.rpm", "needs_root": true, "source": "https://support.zoom.com/hc/en/article?id=zm_kb&sysparm_article=KB0063458"}, {"method": "yum (Fedora/RHEL/CentOS/Oracle Linux): install downloaded RPM", "command": "sudo yum install zoom_x86_64.rpm", "needs_root": true, "source": "https://support.zoom.com/hc/en/article?id=zm_kb&sysparm_article=KB0063458"}], "status": "verified", "note": "Official Zoom support article gives DEB and RPM install commands; the page points to the Download Center for the files and lists no dnf command."}
